{
  "id": "mcp-client",
  "name": "MCP Client",
  "version": "0.1.0",
  "description": "连接已审核的本地 MCP stdio 服务，并将其工具桥接到 Agent。",
  "kind": "integration",
  "dependencies": ["agent-runtime"],
  "provides": ["mcp.tools"],
  "permissions": ["process:spawn", "network:mcp"],
  "origin": "local",
  "configurable": true,
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "servers": {
        "type": "array",
        "title": "MCP 服务",
        "description": "仅连接已审核的本地 stdio MCP 服务。启用插件时将启动这些进程。",
        "default": [],
        "items": {
          "type": "object",
          "title": "服务",
          "required": ["id", "command"],
          "properties": {
            "id": { "type": "string", "title": "标识", "description": "小写字母、数字和连字符。" },
            "command": { "type": "string", "title": "启动命令" },
            "args": { "type": "array", "title": "命令参数", "default": [], "items": { "type": "string", "title": "参数" } },
            "env": {
              "type": "object",
              "title": "环境变量",
              "description": "键值对，例如 API 地址或令牌引用。",
              "default": {},
              "properties": {}
            }
          }
        }
      }
    }
  },
  "ui": {
    "settings": {
      "label": "MCP 连接",
      "description": "配置受信任 MCP 服务，并将其工具桥接给 Agent。",
      "icon": "plug"
    }
  },
  "default_enabled": false,
  "entry": "./index.js"
}
